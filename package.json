{
  "name": "linemix",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p apps/web && tsc --noEmit -p packages/model",
    "test": "vitest run --project '!db'",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "supabase gen types typescript --local > apps/web/src/lib/supabase/database.types.ts",
    "db:reset": "supabase db reset && pnpm db:types"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
